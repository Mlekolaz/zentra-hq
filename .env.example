NODE_ENV=development
RUNTIME_MODE=in-memory
PORT=4100
# HOST defaults to 127.0.0.1 locally and 0.0.0.0 in production.
# HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
WEBHOOK_DEV_SECRET=local-development-only
WEBHOOK_VERIFIER=development
EMBEDDED_WORKER=true
# Required to enable POST /v1/webhooks/zentra; use at least 32 random characters.
# ZENTRA_WEBHOOK_SECRET=
# HQ_URL=http://127.0.0.1:4100
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
